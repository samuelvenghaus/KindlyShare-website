DATABASE_URL="postgresql://user:password@localhost:5432/kindlyshare"
SESSION_SECRET="generate-a-long-random-string-for-jwt-signing"

# 32 random bytes, base64-encoded. Genereer met:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Willekeurige string die je ook meegeeft als Bearer-token wanneer je
# /api/cron/sync-reviews aanroept vanuit een externe scheduler (bv. Vercel Cron).
CRON_SECRET=""

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Redirect URI: <APP_URL>/api/google/callback
# Vereist toegang tot de Business Profile APIs (accountmanagement, businessinformation)
# en het legacy Google My Business API v4 voor reviews - dit moet je zelf aanvragen/inschakelen
# bij Google, dat kan ik niet namens je doen.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Basis-URL van de app, gebruikt om de OAuth redirect-URI op te bouwen.
APP_URL="http://localhost:3000"

# Anthropic API-key voor AI-classificatie en oplossingssuggesties.
# Aanmaken op https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Trustpilot Business-portaal (developers.trustpilot.com) > je app > API key/secret.
# Redirect URI: <APP_URL>/api/trustpilot/callback
# Let op: het exacte reviews-endpoint is niet live geverifieerd bij het bouwen van
# deze integratie (developers.trustpilot.com was niet bereikbaar) - test dit als
# eerste bij het inschakelen.
TRUSTPILOT_API_KEY=""
TRUSTPILOT_API_SECRET=""

# App Store Connect-koppeling heeft geen omgevingsvariabelen nodig - Issuer ID,
# Key ID en de .p8 private key vul je per bedrijf in via de Kanalen-pagina.

# Resend (https://resend.com) API-key voor e-mailnotificaties bij nieuwe alerts.
# ALERT_EMAIL_FROM moet een op Resend geverifieerd afzenderadres zijn (bv. alerts@jouwdomein.nl).
# Zonder deze variabelen worden er geen e-mailnotificaties verstuurd.
RESEND_API_KEY=""
ALERT_EMAIL_FROM=""

# Slack-notificaties bij nieuwe alerts hebben geen omgevingsvariabele nodig - de
# incoming-webhook-URL vul je per bedrijf in via Instellingen > Notificaties.
