DATABASE_URL="postgresql://user:password@localhost:5432/kindlyshare"
SESSION_SECRET="generate-a-long-random-string-for-jwt-signing"

# 32 random bytes, base64-encoded. Genereer met:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Willekeurige string die je ook meegeeft als Bearer-token wanneer je
# /api/cron/sync-reviews aanroept vanuit een externe scheduler (bv. Vercel Cron).
CRON_SECRET=""

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Redirect URI: <APP_URL>/api/google/callback
# Vereist toegang tot de Business Profile APIs (accountmanagement, businessinformation)
# en het legacy Google My Business API v4 voor reviews - dit moet je zelf aanvragen/inschakelen
# bij Google, dat kan ik niet namens je doen.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Basis-URL van de app, gebruikt om de OAuth redirect-URI op te bouwen.
APP_URL="http://localhost:3000"
