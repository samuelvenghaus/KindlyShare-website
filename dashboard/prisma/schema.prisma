generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  google
  trustpilot
  app_store
  facebook
  tiktok
  instagram
  overig
  email_campaign
}

enum Sentiment {
  positive
  neutral
  negative
}

enum FeedbackType {
  praise
  interest
  problem
  solution
}

enum Priority {
  low
  medium
  high
}

enum UserRole {
  owner
  member
}

enum CampaignStatus {
  draft
  sending
  sent
}

enum CampaignRecipientStatus {
  pending
  sent
  responded
  bounced
  unsubscribed
}

model Company {
  id                   String               @id @default(uuid())
  name                 String
  createdAt            DateTime             @default(now()) @map("created_at")
  // Notificatie-instellingen bij nieuwe alerts (los van de vaste alert-drempel zelf).
  alertEmailEnabled    Boolean              @default(true) @map("alert_email_enabled")
  // Versleuteld opgeslagen (zelfde aanpak als OAuth-tokens): een Slack incoming-webhook-URL is een bearer secret.
  alertSlackWebhookUrl String?              @map("alert_slack_webhook_url")
  // Standaard afzendergegevens voor feedback-campagnes (weergavenaam + antwoordadres;
  // de mail zelf wordt technisch verstuurd via ons geverifieerde domein).
  campaignSenderName   String?              @map("campaign_sender_name")
  campaignReplyToEmail String?              @map("campaign_reply_to_email")
  users                User[]
  platformConnections  PlatformConnection[]
  reviews              Review[]
  topics               Topic[]
  alerts               Alert[]
  campaigns            Campaign[]

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String   @map("company_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(owner)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("users")
}

model PlatformConnection {
  id                String    @id @default(uuid())
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         String    @map("company_id")
  platform          Platform
  externalAccountId String?   @map("external_account_id")
  // Google/Trustpilot (OAuth): versleuteld access-token.
  // Apple (App Store Connect): versleutelde .p8 private key.
  accessToken       String?   @map("access_token")
  refreshToken      String?   @map("refresh_token")
  tokenExpiresAt    DateTime? @map("token_expires_at")
  // Alleen voor Apple App Store Connect:
  appleKeyId        String?   @map("apple_key_id")
  appleIssuerId     String?   @map("apple_issuer_id")
  lastSyncedAt      DateTime? @map("last_synced_at")
  status            String    @default("active")

  @@unique([companyId, platform, externalAccountId])
  @@index([companyId])
  @@map("platform_connections")
}

model Review {
  id               String        @id @default(uuid())
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId        String        @map("company_id")
  platform         Platform
  externalReviewId String        @map("external_review_id")
  author           String?
  rating           Decimal?      @db.Decimal(2, 1)
  text             String?
  postedAt         DateTime?     @map("posted_at")
  fetchedAt        DateTime      @default(now()) @map("fetched_at")
  sentiment        Sentiment?
  feedbackType     FeedbackType? @map("feedback_type")
  // Door AI bepaald: false = ruis (bv. spam/emoji/grapjes/tags in Instagram-comments),
  // telt niet mee in dashboards, rapporten of alerts. Default true zodat platforms waar
  // elke review per definitie relevant is (Google/Trustpilot/App Store) ongewijzigd blijven.
  isRelevant       Boolean       @default(true) @map("is_relevant")
  topics           ReviewTopic[]

  @@unique([platform, externalReviewId])
  @@index([companyId])
  @@map("reviews")
}

model Topic {
  id        String        @id @default(uuid())
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String        @map("company_id")
  label     String
  reviews   ReviewTopic[]
  alerts    Alert[]

  @@unique([companyId, label])
  @@map("topics")
}

model ReviewTopic {
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId String @map("review_id")
  topic    Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId  String @map("topic_id")

  @@id([reviewId, topicId])
  @@map("review_topics")
}

model Alert {
  id                 String   @id @default(uuid())
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          String   @map("company_id")
  topic              Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicId            String?  @map("topic_id")
  reviewCount        Int      @map("review_count")
  timeWindowDays     Int      @map("time_window_days")
  increasePercentage Decimal  @map("increase_percentage") @db.Decimal(5, 1)
  priority           Priority
  aiSuggestion       String?  @map("ai_suggestion")
  createdAt          DateTime @default(now()) @map("created_at")
  resolved           Boolean  @default(false)

  @@index([companyId])
  @@map("alerts")
}

model Campaign {
  id           String              @id @default(uuid())
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String              @map("company_id")
  name         String
  subject      String
  bodyHtml     String              @map("body_html")
  senderName   String              @map("sender_name")
  replyToEmail String              @map("reply_to_email")
  status       CampaignStatus      @default(draft)
  createdAt    DateTime            @default(now()) @map("created_at")
  sentAt       DateTime?           @map("sent_at")
  recipients   CampaignRecipient[]

  @@index([companyId])
  @@map("campaigns")
}

model CampaignRecipient {
  id             String                  @id @default(uuid())
  campaign       Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     String                  @map("campaign_id")
  email          String
  name           String?
  // Willekeurige, unieke token die het formulier-/afmeldlinkje identificeert (geen login nodig).
  token          String                  @unique
  status         CampaignRecipientStatus @default(pending)
  sentAt         DateTime?               @map("sent_at")
  openedAt       DateTime?               @map("opened_at")
  reminderSentAt DateTime?               @map("reminder_sent_at")
  respondedAt    DateTime?               @map("responded_at")
  unsubscribedAt DateTime?               @map("unsubscribed_at")
  // Losse verwijzing (geen formele relatie) naar de review die uit hun antwoord is ontstaan.
  reviewId       String?                 @map("review_id")

  @@index([campaignId])
  @@map("campaign_recipients")
}
